<?xml version="1.0" encoding="utf-8" ?>

<component name="PosterItem" extends="Group">
    <interface>
        <field id="width"       type="float" onChange="updateLayout"/>
        <field id="height"      type="float" onChange="updateLayout"/>
        <field id="itemContent" type="node" onChange="itemContentChanged"/>
    </interface>
    <script type="text/brightscript" uri="pkg:/components/generic/utility/isValid.brs" />
    <script type="text/brightscript" uri="pkg:/components/ui/PosterItem.brs" />
    <children>
        <!--[351,197] is our item size, poster is hardcoded to 197 but true item size will be background.-->
        <Rectangle
        id="ibackground"
        color="0x1f1f1f" />
        <Poster id="poster" loadDisplayMode="limitSize" loadWidth="390" loadHeight="220" translation="[10,10]">
        </Poster>
        <!-- Placeholder overlay for pulsing animation while loading -->
        <Rectangle id="placeholderOverlay" color="0x3a3a3a" width="390" height="220" translation="[10,10]" visible="false" opacity="0.5" />
        <Rectangle id="liveDotBg" color="0x000000AA" width="28" height="28" translation="[10,10]" visible="false" />
        <Rectangle id="liveDot" color="0xFF0000FF" width="12" height="12" translation="[18,18]" visible="false" />
        <Label id="title" font="font:Inter-Emoji" color="#ffffff" translation="[10,240]" wrap = "true" numLines = "2" lineSpacing = "0" text="title">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>
        <Label id="published" font="font:Inter-Emoji" color="#ffffff" translation="[10,277]" text="date">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>
        <!--
        <Label id="published" font="font:Inter-Emoji" color="#ffffff" translation="[10,245]" text="date">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>
        <Label id="lbc" font="font:Inter-Emoji" color="#ffffff" translation="[10,277]" text="lbc">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>
        -->
        <Poster id="channelIcon" width="20" height="20" translation="[10,310]" visible="true" />
        <Label id="creator" font="font:Inter-Emoji" color="#ffffff" translation="[40,310]" text="publisher">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>
        <Rectangle
        id="lbackground"
        color="0x000000aa"
        width="130"
        height="29"
        translation="[10,185]" />
        <Label id="videoLength" width="120" height="32" font="font:Inter-Emoji" color="#ffffff" translation="[10,182]" horizAlign="left" vertAlign="center" numLines = "1" text="00:00:00:00">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>

        <!-- Live viewers chip at bottom-left of poster -->
        <Rectangle
        id="vbackground"
        color="0x000000aa"
        width="140"
        height="29"
        translation="[10,185]"
        visible="false" />
        <Poster id="viewersIcon" width="16" height="16" translation="[12,186]" visible="false"/>
        <Label id="viewers" width="130" height="32" font="font:Inter-Emoji" color="#ffffff" translation="[32,182]" horizAlign="left" vertAlign="center" numLines = "1" text="">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="24"/>
        </Label>

        <Rectangle
        id="rbackground"
        color="0x000000aa"
        width="280"
        height="29"
        translation="[10,15]" 
        visible="false"/>
        <Poster id="repostIcon" uri = "pkg:/images/png/Icon-Repeat.png" translation="[10,14]" width="29" height="29" visible="false"/>
        <Label id="repostedBy" width="250" height="32" font="font:Inter-Emoji" color="#ffffff" translation="[40,12]" horizAlign="center" vertAlign="center" numLines = "1" text="user" visible="false">
        <Font role="font" uri = "pkg:/components/generic/fonts/Inter-Emoji.otf" fallbackGlyph="u0020" size="20"/>
        </Label>
        <!-- Pulse animation for placeholder overlay -->
        <Animation id="placeholderPulse" duration="1.4" repeat="true">
            <FloatFieldInterpolator fieldToInterp="placeholderOverlay.opacity" key="[0.0, 0.5, 1.0]" keyValue="[0.35, 0.75, 0.35]"/>
        </Animation>
    </children>
</component>
